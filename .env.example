# Optional server-side delivery. Leave unset to use the email-app fallback.
# Set these on your hosting service when you are ready to enable direct sending.
CONTACT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a sender address on a domain verified with the email provider.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=kwame@owusuboakye.com

# Optional site-wide visit counter; keep these server-side (never NEXT_PUBLIC_).
# Leave disabled in development. Run docs/site-views.sql in Turso before enabling.
SITE_VIEWS_ENABLED=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
